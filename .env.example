APP_ENV=production
APP_PORT=8080

# JWT
JWT_SECRET=secret
JWT_EXPIRY=24h

# Neon production (default, langsung di .env)
DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-crimson-darkness-azfc0tb6.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Environment lainnya pakai file terpisah: ---
# .env.testing     -> DATABASE_URL branch testing  (jalankan: APP_ENV=testing go run ./cmd/api)
# .env.production  -> DATABASE_URL branch production
#
# Contoh isi .env.testing:
# APP_ENV=testing
# DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-cool-tooth-aznkb6kh.c-3.ap-southeast-1.aws.neon.tech/sistem_service_motor?sslmode=require&channel_binding=require
#
# Saat DATABASE_URL terisi, nilai DB_* di bawah diabaikan
# (fallback untuk postgres lokal via docker compose):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=my_api
DB_SSLMODE=disable
